# Hugging Face Spaces - Files to ignore

# Frontend (deployed separately)
physical-ai-docs/
node_modules/

# Auth server (deployed separately)
auth-server/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
env/
venv/
.venv/
ENV/

# Environment files (use HF Secrets instead)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git
.git/
.gitignore

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.bak
*~

# Documentation build
docs/_build/
