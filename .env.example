# Hugging Face Space Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Set your OpenAI API key in a local `.env` file; do NOT commit real keys.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Qdrant Database Configuration
QDRANT_URL=https://your-qdrant-instance.example
QDRANT_API_KEY=YOUR_QDRANT_API_KEY_HERE

# Authentication Server Configuration
AUTH_SERVER_URL=http://localhost:10000

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:10000
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE